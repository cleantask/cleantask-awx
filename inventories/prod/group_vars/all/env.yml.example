---
# Production inventory overlays (copy to env.yml when provisioning prod).
# Secrets stay in inventories/prod/vault.yml.

env_name: prod

app_domain: app.cleantask.co
website_domain: cleantask.co
docs_domain: docs.cleantask.co

# Nginx + Cloudflare Tunnel (tunnel_setup.yml). Prod is indexable.
nginx_noindex: false
# UUID from `cloudflared tunnel create cleantask-prod`
cloudflare_tunnel_id: A_RENSEIGNER

app_root: /opt/cleantask
app_version: main
app_media_host_path: /var/lib/cleantask/media

# PERF_TEST_CPX42.md — CPX42 (8 vCPU / 16 GiB): use 8–9 web workers.
app_gunicorn_workers: 8

# PostgreSQL tuned for ~16 GiB (override after measuring).
pg_shared_buffers_mb: 4096
pg_effective_cache_size_mb: 10240
pg_work_mem_mb: 16
pg_maintenance_work_mem_mb: 512
pg_max_connections: 200
