---
# Staging secrets — encrypt_string (not whole-file encrypt). See GUIDE_AWX §2.
#
# Path: inventories/staging/vault.yml  (NOT under group_vars — AWX corrupts
# !vault when importing inventory group_vars). Loaded by role load_vault.
# Prod: inventories/prod/vault.yml
#
# Staging ≈ ~/Dev/cleantask/.env. Host overlays (DATABASE_URL, SITE_URL, …)
# come from roles/app — do not vault those.
#
#   .venv/bin/ansible-vault encrypt_string --stdin-name 'vault_…'
# Mot de passe du coffre → AWX credential vault-cleantask (jamais dans Git).

# ── server_setup ──────────────────────────────────────────────────────────
vault_pg_password: A_RENSEIGNER

# ── deploy — boot / crypto ────────────────────────────────────────────────
vault_django_secret_key: A_RENSEIGNER
vault_django_secret_key_fallbacks: ""
vault_field_encryption_salt: A_RENSEIGNER
vault_redis_password: A_RENSEIGNER
vault_redis_cache_password: A_RENSEIGNER
# Read-only deploy key for cleantask/cleantask only (GitHub → Deploy keys).
vault_app_git_deploy_key: A_RENSEIGNER

# Separate keys for static sites (GitHub forbids reusing one pubkey on two repos).
vault_website_git_deploy_key: A_RENSEIGNER   # cleantask/cleantask-website
vault_docs_git_deploy_key: A_RENSEIGNER      # cleantask/cleantask-docs

# Staging demo seed only (seed_demo.yml → CLEANTASK_DEMO_PASSWORD). Not used in prod.
vault_demo_password: A_RENSEIGNER

# ── email / OAuth ─────────────────────────────────────────────────────────
# Outlook is required for production settings to boot.
vault_outlook_client_id: A_RENSEIGNER
vault_outlook_client_secret: A_RENSEIGNER
vault_outlook_client_secret_expires_at: A_RENSEIGNER
vault_postmark_server_token: A_RENSEIGNER
vault_gmail_client_id: A_RENSEIGNER
vault_gmail_client_secret: A_RENSEIGNER
# SMTP fallback only (empty OK if Postmark is set):
# vault_email_host: …
# vault_email_host_user: …
# vault_email_host_password: …

# ── Turnstile ─────────────────────────────────────────────────────────────
vault_turnstile_secret_key: A_RENSEIGNER
# Site key is public → inventories/<env>/group_vars (app_turnstile_site_key)

# ── Stripe ────────────────────────────────────────────────────────────────
vault_stripe_secret_key: A_RENSEIGNER
vault_stripe_webhook_secret: A_RENSEIGNER
# Publishable + price IDs → inventory (app_stripe_*)

# ── Company lookup ────────────────────────────────────────────────────────
vault_cbeapi_api_key: A_RENSEIGNER

# ── Assistant / document AI ───────────────────────────────────────────────
vault_assistant_openrouter_api_key: A_RENSEIGNER
# vault_assistant_azure_api_key: …
# vault_assistant_local_api_key: …   # useless on the server (localhost)

# ── Cloudflare Tunnel (tunnel_setup) ──────────────────────────────────────
# Full JSON from ~/.cloudflared/<tunnel-id>.json after:
#   cloudflared tunnel create cleantask-staging
# Encrypt with ansible-vault encrypt_string — keep as a multi-line string.
vault_cloudflare_tunnel_credentials: |
  {
    "AccountTag": "…",
    "TunnelSecret": "…",
    "TunnelID": "…"
  }

# ── optional ──────────────────────────────────────────────────────────────
# vault_sentry_dsn: …
