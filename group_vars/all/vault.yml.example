---
# Secrets — each value encrypted with ansible-vault encrypt_string (not the
# whole file). See docs/GUIDE_AWX.md §2.
#
# Staging: copy values from ~/Dev/cleantask/.env (same SECRET_KEY / OAuth /
# encryption salt as local). Host overlays (DATABASE_URL, SITE_URL, …) are
# generated by roles/app/templates/env.j2 — do not vault those.
#
#   .venv/bin/ansible-vault encrypt_string --stdin-name 'vault_…'
#   # paste value → Enter → Ctrl-D → paste !vault block into vault.yml
#
# Mot de passe du coffre → credential AWX vault-cleantask (jamais dans Git).

# ── server_setup ──────────────────────────────────────────────────────────
vault_pg_password: A_RENSEIGNER

# ── deploy — boot / crypto ────────────────────────────────────────────────
vault_django_secret_key: A_RENSEIGNER
vault_django_secret_key_fallbacks: ""
vault_field_encryption_salt: A_RENSEIGNER
vault_redis_password: A_RENSEIGNER
vault_redis_cache_password: A_RENSEIGNER
vault_outlook_client_id: A_RENSEIGNER
vault_outlook_client_secret: A_RENSEIGNER
vault_outlook_client_secret_expires_at: A_RENSEIGNER
vault_app_git_deploy_key: A_RENSEIGNER

# ── email / OAuth ─────────────────────────────────────────────────────────
vault_postmark_server_token: A_RENSEIGNER
vault_gmail_client_id: A_RENSEIGNER
vault_gmail_client_secret: A_RENSEIGNER
# SMTP fallback only (empty OK if Postmark is set):
# vault_email_host: …
# vault_email_host_user: …
# vault_email_host_password: …

# ── Turnstile ─────────────────────────────────────────────────────────────
vault_turnstile_secret_key: A_RENSEIGNER
# Site key is public → inventories/<env>/group_vars (app_turnstile_site_key)

# ── Stripe ────────────────────────────────────────────────────────────────
vault_stripe_secret_key: A_RENSEIGNER
vault_stripe_webhook_secret: A_RENSEIGNER
# Publishable + price IDs → inventory (app_stripe_*)

# ── Company lookup ────────────────────────────────────────────────────────
vault_cbeapi_api_key: A_RENSEIGNER

# ── Assistant / document AI ───────────────────────────────────────────────
vault_assistant_openrouter_api_key: A_RENSEIGNER
# vault_assistant_azure_api_key: …
# vault_assistant_local_api_key: …   # useless on the server (localhost)

# ── optional ──────────────────────────────────────────────────────────────
# vault_sentry_dsn: …
