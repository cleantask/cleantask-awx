# Managed by Ansible (roles/cloudflared). Tunnel → host Nginx only.
tunnel: {{ cloudflare_tunnel_id }}
credentials-file: /etc/cloudflared/{{ cloudflare_tunnel_id }}.json

ingress:
  - hostname: {{ app_domain }}
    service: {{ cloudflared_nginx_url }}
  - hostname: {{ website_domain }}
    service: {{ cloudflared_nginx_url }}
  - hostname: {{ docs_domain }}
    service: {{ cloudflared_nginx_url }}
  - service: http_status:404
