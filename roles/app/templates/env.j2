# Managed by Ansible (roles/app). Do not edit by hand — change vault / inventory then redeploy.

# ─── Django core ──────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY={{ vault_django_secret_key }}
SECRET_KEY_FALLBACKS={{ vault_django_secret_key_fallbacks | default('') }}
FIELD_ENCRYPTION_SALT={{ vault_field_encryption_salt }}
ALLOWED_HOSTS={{ app_domain }},localhost,127.0.0.1
SITE_URL=https://{{ app_domain }}
DOCS_URL=https://{{ docs_domain }}
TIME_ZONE={{ server_timezone }}
DJANGO_LOG_LEVEL={{ app_django_log_level }}
TRUST_PROXY_HEADERS=True
SECURE_SSL_REDIRECT=True
ADMIN_UPGRADE_EMAIL={{ app_admin_upgrade_email }}
BOOK_A_CALL_URL={{ app_book_a_call_url }}

# ─── Docker / media ───────────────────────────────────────────────────────
SERVE_STATIC_WHITENOISE=True
MEDIA_ROOT=/app/media
MEDIA_HOST_PATH={{ app_media_host_path }}

# ─── Database (PostgreSQL on the host via db.internal → host-gateway) ─────
DATABASE_URL={{ app_database_url }}

# ─── Redis (Compose services) ─────────────────────────────────────────────
REDIS_PASSWORD={{ vault_redis_password }}
REDIS_CACHE_PASSWORD={{ vault_redis_cache_password }}
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis-cache:6379/0
{% if app_redis_cache_maxmemory is defined and app_redis_cache_maxmemory %}
REDIS_CACHE_MAXMEMORY={{ app_redis_cache_maxmemory }}
{% endif %}

# ─── Email ────────────────────────────────────────────────────────────────
DEFAULT_FROM_EMAIL={{ app_default_from_email }}
REPLY_TO_EMAIL={{ app_reply_to_email }}
{% if vault_postmark_server_token is defined and vault_postmark_server_token %}
POSTMARK_SERVER_TOKEN={{ vault_postmark_server_token }}
{% endif %}
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST={{ vault_email_host | default('') }}
EMAIL_PORT={{ vault_email_port | default(587) }}
EMAIL_USE_TLS=True
EMAIL_HOST_USER={{ vault_email_host_user | default('') }}
EMAIL_HOST_PASSWORD={{ vault_email_host_password | default('') }}

# ─── Outlook / Entra (required to boot production settings) ───────────────
OUTLOOK_CLIENT_ID={{ vault_outlook_client_id }}
OUTLOOK_CLIENT_SECRET={{ vault_outlook_client_secret }}
OUTLOOK_CLIENT_SECRET_EXPIRES_AT={{ vault_outlook_client_secret_expires_at }}
OUTLOOK_AUTHORITY=https://login.microsoftonline.com/common

# ─── Gmail OAuth ──────────────────────────────────────────────────────────
{% if vault_gmail_client_id is defined and vault_gmail_client_id %}
GMAIL_CLIENT_ID={{ vault_gmail_client_id }}
GMAIL_CLIENT_SECRET={{ vault_gmail_client_secret }}
GMAIL_INBOX_SCOPES_ENABLED={{ app_gmail_inbox_scopes_enabled | default('False') }}
{% endif %}

# ─── Sentry (optional) ────────────────────────────────────────────────────
{% if vault_sentry_dsn is defined and vault_sentry_dsn %}
SENTRY_DSN={{ vault_sentry_dsn }}
SENTRY_TRACES_SAMPLE_RATE={{ app_sentry_traces_sample_rate }}
{% endif %}

# ─── Turnstile ────────────────────────────────────────────────────────────
{% if app_turnstile_site_key is defined and app_turnstile_site_key and vault_turnstile_secret_key is defined and vault_turnstile_secret_key %}
TURNSTILE_ENABLED={{ app_turnstile_enabled | default('True') }}
TURNSTILE_SITE_KEY={{ app_turnstile_site_key }}
TURNSTILE_SECRET_KEY={{ vault_turnstile_secret_key }}
{% else %}
TURNSTILE_ENABLED=False
{% endif %}

# ─── Stripe ───────────────────────────────────────────────────────────────
{% if vault_stripe_secret_key is defined and vault_stripe_secret_key %}
STRIPE_SECRET_KEY={{ vault_stripe_secret_key }}
STRIPE_PUBLISHABLE_KEY={{ app_stripe_publishable_key }}
STRIPE_WEBHOOK_SECRET={{ vault_stripe_webhook_secret | default('') }}
STRIPE_PRICE_STARTER={{ app_stripe_price_starter }}
STRIPE_PRICE_PROFESSIONAL={{ app_stripe_price_professional }}
STRIPE_PRICE_BUSINESS={{ app_stripe_price_business }}
{% endif %}

# ─── Company lookup ───────────────────────────────────────────────────────
{% if vault_cbeapi_api_key is defined and vault_cbeapi_api_key %}
COMPANY_LOOKUP_PROVIDER={{ app_company_lookup_provider | default('cbeapi') }}
COMPANY_LOOKUP_TIMEOUT={{ app_company_lookup_timeout | default(8) }}
CBEAPI_BASE_URL={{ app_cbeapi_base_url | default('https://cbeapi.be/api') }}
CBEAPI_API_KEY={{ vault_cbeapi_api_key }}
CBEAPI_LANG={{ app_cbeapi_lang | default('fr') }}
{% endif %}

# ─── Assistant / document AI ──────────────────────────────────────────────
ASSISTANT_LLM_PROVIDER={{ app_assistant_llm_provider | default('mock') }}
DOCUMENT_AI_PROVIDER={{ app_document_ai_provider | default('mock') }}
ASSISTANT_LLM_TIMEOUT={{ app_assistant_llm_timeout | default(60) }}
ASSISTANT_MAX_TOOL_LOOPS={{ app_assistant_max_tool_loops | default(4) }}
ASSISTANT_MAX_ROWS_PER_TOOL={{ app_assistant_max_rows_per_tool | default(50) }}
ASSISTANT_USER_HOURLY_QUOTA={{ app_assistant_user_hourly_quota | default(30) }}
{% if vault_assistant_openrouter_api_key is defined and vault_assistant_openrouter_api_key %}
ASSISTANT_OPENROUTER_API_KEY={{ vault_assistant_openrouter_api_key }}
ASSISTANT_OPENROUTER_MODEL={{ app_assistant_openrouter_model }}
ASSISTANT_OPENROUTER_BASE_URL={{ app_assistant_openrouter_base_url }}
ASSISTANT_OPENROUTER_ZDR={{ app_assistant_openrouter_zdr | default('true') }}
{% endif %}
ASSISTANT_AZURE_API_VERSION={{ app_assistant_azure_api_version | default('2024-10-21') }}
ASSISTANT_BEDROCK_REGION={{ app_assistant_bedrock_region | default('eu-central-1') }}
{% if vault_assistant_azure_api_key is defined and vault_assistant_azure_api_key %}
ASSISTANT_AZURE_API_KEY={{ vault_assistant_azure_api_key }}
ASSISTANT_AZURE_ENDPOINT={{ app_assistant_azure_endpoint | default('') }}
ASSISTANT_AZURE_DEPLOYMENT={{ app_assistant_azure_deployment | default('') }}
{% endif %}
